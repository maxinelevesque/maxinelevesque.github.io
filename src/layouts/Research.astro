---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    summary?: string;
    date: string;
    readTime: string;
    coauthor?: string;
    coauthorNote?: string;
    contributors?: { name: string; role?: string }[];
    readAloud?: string;
    system?: number;
  };
}

// Research reports: the ochre register. Like a dialogue, a report may be
// co-written; unlike one, the coauthor is optional, contributions are credited
// by role at the foot of the page, and a read-aloud companion may be linked.
const { frontmatter } = Astro.props;
const systemIndex = frontmatter.system ?? 9;
const coauthor = frontmatter.coauthor;
const contributors = frontmatter.contributors ?? [];
---
<Base
  title={frontmatter.title}
  description={frontmatter.summary ?? frontmatter.subtitle}
  theme="research"
  ogType="article"
  published={frontmatter.date}
  author={coauthor ? `Maxine Levesque × ${coauthor}` : 'Maxine Levesque'}
>
  <div class="page">
    <!-- Dynamical system background -->
    <div class="system-canvas">
      <canvas
        id="system-canvas"
        style="width: 100%; height: 100%;"
        data-system-index={systemIndex}
        data-system-color="#c09445"
      ></canvas>
    </div>

    <div class="content">
      <div class="crumb"><a href="/">Maxine's dream machine</a> → Research</div>

      <div class="category">RESEARCH REPORT</div>

      <h1 class="title">{frontmatter.title}</h1>

      {frontmatter.subtitle && (
        <p class="subtitle">{frontmatter.subtitle}</p>
      )}

      <div class="byline">
        <span class="author">Maxine Levesque</span>
        {coauthor && (<>
          <span class="times">×</span>
          <span class="coauthor">{coauthor}{frontmatter.coauthorNote && (<sup class="note-mark"><a href="#coauthor-note" aria-label="Note on the coauthor">*</a></sup>)}</span>
        </>)}
        <span class="sep">·</span>
        <span>{frontmatter.date}</span>
        <span class="sep">·</span>
        <span>{frontmatter.readTime}</span>
        {frontmatter.readAloud && (<>
          <span class="sep">·</span>
          <a class="read-aloud" href={frontmatter.readAloud}>Read-aloud text</a>
        </>)}
      </div>

      <div class="rule"></div>

      <div class="article-body research">
        <slot />
      </div>

      {(frontmatter.coauthorNote || contributors.length > 0) && (
        <aside class="provenance">
          {frontmatter.coauthorNote && (
            <p class="coauthor-note" id="coauthor-note">
              <span class="note-mark">*</span> {frontmatter.coauthorNote}
            </p>
          )}
          {contributors.length > 0 && (
            <dl class="contributions" aria-label="Contributions">
              {contributors.map((c) => (
                <div class="contribution">
                  <dt>{c.name}</dt>
                  {c.role && <dd>{c.role}</dd>}
                </div>
              ))}
            </dl>
          )}
        </aside>
      )}

      <div class="page-footer">
        <span>© 2026 Maxine Levesque</span>
        <span class="system-label" id="system-label"></span>
      </div>
    </div>
  </div>

  <script>
    import { initSystem, SYSTEM_NAMES } from '../components/dynamical-systems.js';
    const canvas = document.getElementById('system-canvas');
    if (canvas) {
      const idx = Number(canvas.dataset.systemIndex ?? 9);
      const color = canvas.dataset.systemColor ?? '#c09445';
      initSystem(canvas, idx, color);
      const label = document.getElementById('system-label');
      if (label) label.textContent = 'Animation: ' + SYSTEM_NAMES[idx % SYSTEM_NAMES.length];
    }
  </script>
</Base>

<style>
  .page {
    background: var(--res-bg);
    color: var(--res-text);
    font-family: var(--font-body);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }
  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.8rem 1.5rem 5rem;
    position: relative;
    z-index: 1;
  }
  .crumb {
    font-size: 0.72rem;
    color: var(--res-text-muted);
    margin-bottom: 3.5rem;
    opacity: 0.5;
    font-style: italic;
    letter-spacing: 0.04em;
  }
  .crumb a { color: inherit; }
  .category {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--res-category);
    margin-bottom: 1rem;
  }
  .title {
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.15;
    font-style: italic;
    margin-bottom: 0.9rem;
    letter-spacing: -0.01em;
    color: #e0dcd4;
  }
  .subtitle {
    font-size: 0.95rem;
    color: var(--res-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-style: italic;
    max-width: 480px;
  }
  .byline {
    font-size: 0.82rem;
    color: var(--res-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.8rem;
    align-items: baseline;
    margin-bottom: 2.2rem;
    line-height: 1.9;
  }
  .author { color: var(--res-text); font-style: italic; }
  .times { opacity: 0.25; font-size: 0.72rem; }
  .coauthor { color: var(--res-accent); font-style: italic; }
  .note-mark { font-style: normal; font-size: 0.72em; opacity: 0.7; margin-left: 0.1em; }
  .note-mark a { color: inherit; text-decoration: none; }
  .read-aloud { color: var(--res-link); text-decoration: none; font-style: italic; }
  .read-aloud:hover { text-decoration: underline; }
  .provenance {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--res-rule);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--res-text-muted);
  }
  .coauthor-note { font-style: italic; margin-bottom: 0.8rem; }
  .contributions { display: grid; gap: 0.2rem; }
  .contribution { display: flex; gap: 0.6rem; align-items: baseline; }
  .contribution dt { color: var(--res-text); font-style: italic; }
  .contribution dd { margin: 0; }
  .contribution dd::before { content: '—'; margin-right: 0.6rem; opacity: 0.4; }
  .coauthor-note .note-mark { margin-right: 0.3em; }
  .sep { opacity: 0.2; }
  .rule {
    height: 1px;
    background: linear-gradient(to right, rgba(208, 168, 92, 0.33), transparent 80%);
    margin-bottom: 2.4rem;
  }
  .page-footer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--res-rule);
    font-size: 0.68rem;
    color: var(--res-text-muted);
    opacity: 0.5;
    font-style: italic;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .system-label {
    text-align: right;
  }
</style>
