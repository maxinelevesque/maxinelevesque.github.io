---
import { readFileSync } from 'node:fs';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import remarkMath from 'remark-math';
import rehypeKatex from 'rehype-katex';
import Writing from '../../layouts/Writing.astro';
import presentation from '../../../prototypes/essay-format/presentation.json';
import { remarkEssayPrototype, rehypeColumnNotes } from '../../lib/essay-prototype.mjs';
import remarkAbstract from '../../lib/remark-abstract.mjs';
import '../../styles/site-essay-demo.css';
import 'katex/dist/katex.min.css';

// Explicit opt-in: a normal production build emits no prototype page.
export function getStaticPaths() {
  return import.meta.env.DEV || process.env.ESSAY_PROTOTYPE === '1'
    ? [{ params: { sample: 'essay-format' } }] : [];
}
const source = readFileSync(new URL('../../../prototypes/essay-format/index.md', import.meta.url), 'utf8');
const processor = await createMarkdownProcessor({
  syntaxHighlight: false,
  smartypants: false,
  remarkPlugins: [remarkMath, remarkAbstract, [remarkEssayPrototype, presentation]],
  rehypePlugins: [rehypeKatex, rehypeColumnNotes],
});
// The real Writing layout owns the title, byline, column width, typography,
// palette, and animation. Only the proposed essay elements get extra styling.
const rendered = await processor.render(source.replace(/^# A measure of thirds\s*\n/, ''));
---
<Writing frontmatter={{
  title: 'A measure of thirds',
  subtitle: 'A private placeholder demo of notes, figures, and theorem blocks in the current site format.',
  date: 'November 14, 2026',
  kind: 'essay',
  readTime: '4 min',
  system: 4,
}}>
  <div class="essay-demo">
    <nav class="demo-tools" aria-label="Demo navigation">
      <span>Private placeholder demo</span>
      <a href="/current-site/">Current site for comparison</a>
      <a href="/prototypes/assets/reader.md">Portable Markdown</a>
      <a href="/prototypes/assets/read-aloud.txt">Read-aloud text</a>
    </nav>
    <div class="essay-demo-content" set:html={rendered.code} />
  </div>
  <script>
    import { initColumnNotes } from '../../components/essays/prototype/column-notes.js';
    import { initFractionBars } from '../../components/essays/prototype/fraction-bar.js';
    initFractionBars();
    initColumnNotes();
  </script>
</Writing>
